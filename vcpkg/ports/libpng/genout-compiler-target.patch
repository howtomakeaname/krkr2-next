--- a/scripts/cmake/genout.cmake.in	2026-09-01 02:19:04
+++ b/scripts/cmake/genout.cmake.in	2026-09-01 02:19:04
@@ -20,6 +20,7 @@
 set(AWK "@AWK@")
 set(CMAKE_C_COMPILER "@CMAKE_C_COMPILER@")
 set(CMAKE_C_FLAGS @CMAKE_C_FLAGS@)
+set(CMAKE_C_COMPILER_TARGET "@CMAKE_C_COMPILER_TARGET@")
 set(CMAKE_SYSROOT @CMAKE_SYSROOT@)
 set(INCDIR "@CMAKE_CURRENT_BINARY_DIR@")
 set(PNG_PREFIX "@PNG_PREFIX@")
@@ -29,6 +30,13 @@
 set(ZLIBINCDIR "@ZLIB_INCLUDE_DIRS@")
 
 set(PLATFORM_C_FLAGS)
+# CMAKE_C_FLAGS does not carry the target triple (cross toolchains pass it
+# via CMAKE_C_COMPILER_TARGET, which only CMake's own compile rules honor).
+# Without --target clang preprocesses for the host triple and never searches
+# the sysroot's multiarch include dir (usr/include/aarch64-linux-ohos).
+if(CMAKE_C_COMPILER_TARGET)
+  set(PLATFORM_C_FLAGS ${PLATFORM_C_FLAGS} "--target=${CMAKE_C_COMPILER_TARGET}")
+endif()
 if(APPLE)
   set(CMAKE_OSX_INTERNAL_ARCHITECTURES "@CMAKE_OSX_INTERNAL_ARCHITECTURES@")
   set(CMAKE_OSX_SYSROOT "@CMAKE_OSX_SYSROOT@")
